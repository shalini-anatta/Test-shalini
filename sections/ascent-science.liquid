{%- liquid
  assign science_bg_url = ''
  if section.settings.background_image != blank
    assign science_bg_url = section.settings.background_image | image_url: width: 1440
  endif
-%}

<div
  class="ascent-sci"
  style="--sci-pad-top: {{ section.settings['padding-block-start'] }}px; --sci-pad-bottom: {{ section.settings['padding-block-end'] }}px; {% if science_bg_url != blank %}background-image: url('{{ science_bg_url }}');{% endif %}"
>
  <div class="ascent-sci__overlay"></div>
  <div class="ascent-sci__inner">
    <div class="ascent-sci__header">
      <div class="ascent-sci__header-left">
        {%- if section.settings.section_label != blank -%}
          <p class="ascent-sci__label">{{ section.settings.section_label }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="ascent-sci__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subtext != blank -%}
          <p class="ascent-sci__subtext">{{ section.settings.subtext }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.cta_text != blank -%}
        <a
          class="ascent-sci__cta"
          href="{{ section.settings.cta_url | default: '#' }}"
        >{{ section.settings.cta_text }}</a>
      {%- endif -%}
    </div>

    <div class="ascent-sci__cards">
      <div class="ascent-sci__card">
        <h3 class="ascent-sci__card-title">{{ section.settings.card1_title }}</h3>
        <p class="ascent-sci__card-subtitle">{{ section.settings.card1_subtitle }}</p>
        <div class="ascent-sci__stat">{{ section.settings.card1_stat }}</div>
        <p class="ascent-sci__stat-label">{{ section.settings.card1_stat_label }}</p>
        <p class="ascent-sci__bar-label">ASCENT NATIVE WHEY</p>
        <div class="ascent-sci__chart ascent-sci__chart--bars">
          <div class="ascent-sci__bar-row">
            <div class="ascent-sci__bar ascent-sci__bar--yellow">
              <span class="ascent-sci__bar-val ascent-sci__bar-val--dark">2.6G</span>
            </div>
          </div>
          <div class="ascent-sci__bar-row">
            <div class="ascent-sci__bar ascent-sci__bar--white ascent-sci__bar--narrow">
              <span class="ascent-sci__bar-val">1.8G</span>
            </div>
          </div>
          <p class="ascent-sci__bar-sublabel">TYPICAL WHEY</p>
          <div class="ascent-sci__divider"></div>
          <p class="ascent-sci__mps-label">MPS TRIGGER · 2.3G</p>
        </div>
      </div>

      <div class="ascent-sci__card">
        <h3 class="ascent-sci__card-title">{{ section.settings.card2_title }}</h3>
        <p class="ascent-sci__card-subtitle">{{ section.settings.card2_subtitle }}</p>
        <div class="ascent-sci__stat">{{ section.settings.card2_stat }}</div>
        <p class="ascent-sci__stat-label">{{ section.settings.card2_stat_label }}</p>
        <div class="ascent-sci__chart ascent-sci__chart--line">
          <div class="ascent-sci__legend">
            <span class="ascent-sci__legend-item">
              <span class="ascent-sci__legend-dot ascent-sci__legend-dot--yellow"></span>
              NATIVE WHEY
            </span>
            <span class="ascent-sci__legend-item">
              <span class="ascent-sci__legend-dot ascent-sci__legend-dot--white"></span>
              CHEESE-DERIVED
            </span>
          </div>
          <div class="ascent-sci__line-chart">
            <svg viewBox="0 0 372 130" fill="none" xmlns="http://www.w3.org/2000/svg" class="ascent-sci__svg">
              <path d="M 0 120 C 60 120 80 20 140 15 C 200 10 260 50 372 60" stroke="#FBEC00" stroke-width="2.5" fill="none"/>
              <path d="M 0 120 C 80 115 130 70 200 65 C 270 60 310 75 372 80" stroke="#FFFFFF" stroke-width="2" fill="none"/>
              <circle cx="140" cy="15" r="4.5" fill="#FBEC00"/>
            </svg>
            <div class="ascent-sci__line-labels">
              <span class="ascent-sci__line-label ascent-sci__line-label--left">0</span>
              <span class="ascent-sci__line-label ascent-sci__line-label--right">60 MIN</span>
            </div>
            <div class="ascent-sci__divider"></div>
            <p class="ascent-sci__axis-label">BLOOD LEUCINE</p>
          </div>
        </div>
      </div>

      <div class="ascent-sci__card">
        <h3 class="ascent-sci__card-title">{{ section.settings.card3_title }}</h3>
        <p class="ascent-sci__card-subtitle">{{ section.settings.card3_subtitle }}</p>
        <div class="ascent-sci__stat">{{ section.settings.card3_stat }}</div>
        <p class="ascent-sci__stat-label">{{ section.settings.card3_stat_label }}</p>
        <div class="ascent-sci__chart ascent-sci__chart--temp">
          <div class="ascent-sci__temp-bars">
            <div class="ascent-sci__temp-col">
              <p class="ascent-sci__temp-label">90°C</p>
              <div class="ascent-sci__temp-bar ascent-sci__temp-bar--tall ascent-sci__temp-bar--white"></div>
              <p class="ascent-sci__temp-name">OTHERS</p>
            </div>
            <div class="ascent-sci__temp-col">
              <p class="ascent-sci__temp-label ascent-sci__temp-label--yellow">4°C</p>
              <div class="ascent-sci__temp-bar ascent-sci__temp-bar--short ascent-sci__temp-bar--yellow-fill"></div>
              <p class="ascent-sci__temp-name">ASCENT</p>
            </div>
          </div>
          <div class="ascent-sci__divider"></div>
          <p class="ascent-sci__axis-label">PROCESS TEMP</p>
          <div class="ascent-sci__dots">
            <span class="ascent-sci__dot"></span>
            <span class="ascent-sci__dot"></span>
            <span class="ascent-sci__dot"></span>
            <span class="ascent-sci__dot"></span>
            <span class="ascent-sci__dot"></span>
            <span class="ascent-sci__dot"></span>
            <span class="ascent-sci__dot"></span>
          </div>
          <p class="ascent-sci__intact-label">PROTEIN INTACT</p>
        </div>
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
.ascent-sci {
  position: relative;
  background-color: #1a1a1a;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  padding-block-start: var(--sci-pad-top, 80px);
  padding-block-end: var(--sci-pad-bottom, 80px);
  padding-inline: 20px;
}

.ascent-sci__overlay {
  position: absolute;
  inset: 0;
  background: rgba(26, 26, 26, 0.6);
  z-index: 0;
}

.ascent-sci__inner {
  position: relative;
  z-index: 1;
  max-width: 1328px;
  margin-inline: auto;
  display: flex;
  flex-direction: column;
  gap: 32px;
}

.ascent-sci__header {
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.ascent-sci__header-left {
  display: flex;
  flex-direction: column;
  gap: 16px;
  max-width: 788px;
}

.ascent-sci__label {
  font-family: 'IBM Plex Mono', monospace;
  font-weight: 600;
  font-size: 14px;
  line-height: 20px;
  letter-spacing: 0.84px;
  color: #fbec00;
  margin: 0;
}

.ascent-sci__heading {
  font-family: 'Neue Haas Grotesk Display Pro', system-ui, sans-serif;
  font-weight: 600;
  font-size: 28px;
  line-height: 36px;
  color: #f8f8f8;
  margin: 0;
  max-width: 669px;
}

.ascent-sci__subtext {
  font-family: 'Proxima Nova', Arial, sans-serif;
  font-weight: 600;
  font-size: 16px;
  line-height: 24px;
  color: #ffffff;
  margin: 0;
}

.ascent-sci__cta {
  display: inline-flex;
  align-items: center;
  padding: 18px 40px;
  border: 1.5px solid #fbec00;
  font-family: 'IBM Plex Mono', monospace;
  font-weight: 600;
  font-size: 16px;
  line-height: 20px;
  letter-spacing: 0.96px;
  color: #fbec00;
  text-decoration: none;
  align-self: flex-start;
}

.ascent-sci__cards {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.ascent-sci__card {
  background: rgba(255, 255, 255, 0.06);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border-radius: 2px;
  overflow: hidden;
  padding: 24px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.ascent-sci__card-title {
  font-family: 'Neue Haas Grotesk Display Pro', system-ui, sans-serif;
  font-weight: 600;
  font-size: 24px;
  line-height: 30px;
  color: #ffffff;
  margin: 0;
}

.ascent-sci__card-subtitle {
  font-family: 'Proxima Nova', Arial, sans-serif;
  font-weight: 400;
  font-size: 14px;
  line-height: 20px;
  color: #ffffff;
  margin: 0;
}

.ascent-sci__stat {
  font-family: 'Neue Haas Grotesk Display Pro', system-ui, sans-serif;
  font-weight: 500;
  font-size: 56px;
  line-height: 60px;
  letter-spacing: -1.5px;
  color: #ffffff;
}

.ascent-sci__stat-label {
  font-family: 'Proxima Nova', Arial, sans-serif;
  font-weight: 400;
  font-size: 14px;
  line-height: 17px;
  color: #ffffff;
  margin: 0;
}

.ascent-sci__bar-label {
  font-family: 'IBM Plex Mono', monospace;
  font-weight: 600;
  font-size: 10px;
  line-height: 14px;
  letter-spacing: 0.6px;
  color: #ffffff;
  margin: 0;
}

.ascent-sci__chart {
  margin-block-start: 8px;
}

.ascent-sci__bar-row {
  margin-block-end: 6px;
}

.ascent-sci__bar {
  height: 30px;
  display: flex;
  align-items: center;
  padding-inline: 8px;
  width: 80%;
}

.ascent-sci__bar--yellow { background: #fbec00; width: 75%; }
.ascent-sci__bar--white { background: #ffffff; }
.ascent-sci__bar--narrow { width: 55%; }

.ascent-sci__bar-val {
  font-family: 'IBM Plex Mono', monospace;
  font-weight: 600;
  font-size: 11px;
  line-height: 15px;
  letter-spacing: 0.66px;
  color: #ffffff;
}

.ascent-sci__bar-val--dark { color: #050505; }

.ascent-sci__bar-sublabel {
  font-family: 'IBM Plex Mono', monospace;
  font-weight: 600;
  font-size: 10px;
  line-height: 14px;
  letter-spacing: 0.6px;
  color: #ffffff;
  margin: 4px 0 0;
}

.ascent-sci__divider {
  height: 1px;
  background: #ffffff;
  margin-block: 8px;
}

.ascent-sci__mps-label {
  font-family: 'IBM Plex Mono', monospace;
  font-weight: 600;
  font-size: 10px;
  line-height: 14px;
  letter-spacing: 0.6px;
  color: #fbec00;
  margin: 0;
}

.ascent-sci__legend {
  display: flex;
  flex-direction: row;
  gap: 18px;
  margin-block-end: 8px;
}

.ascent-sci__legend-item {
  display: flex;
  align-items: center;
  gap: 8px;
  font-family: 'IBM Plex Mono', monospace;
  font-weight: 600;
  font-size: 9px;
  line-height: 13px;
  letter-spacing: 0.54px;
  color: #ffffff;
}

.ascent-sci__legend-dot {
  width: 10px;
  height: 10px;
  flex-shrink: 0;
}

.ascent-sci__legend-dot--yellow { background: #fbec00; }
.ascent-sci__legend-dot--white { background: #ffffff; }

.ascent-sci__line-chart {
  position: relative;
}

.ascent-sci__svg {
  width: 100%;
  height: auto;
  display: block;
}

.ascent-sci__line-labels {
  display: flex;
  justify-content: space-between;
  font-family: 'IBM Plex Mono', monospace;
  font-weight: 600;
  font-size: 9px;
  line-height: 13px;
  letter-spacing: 0.54px;
  color: #ffffff;
}

.ascent-sci__axis-label {
  font-family: 'IBM Plex Mono', monospace;
  font-weight: 600;
  font-size: 9px;
  line-height: 13px;
  letter-spacing: 0.54px;
  color: #ffffff;
  margin: 4px 0 0;
}

.ascent-sci__temp-bars {
  display: flex;
  flex-direction: row;
  gap: 24px;
  align-items: flex-end;
  height: 120px;
  margin-block-end: 8px;
}

.ascent-sci__temp-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
}

.ascent-sci__temp-label {
  font-family: 'IBM Plex Mono', monospace;
  font-weight: 600;
  font-size: 12px;
  line-height: 16px;
  letter-spacing: 0.72px;
  color: #ffffff;
  margin: 0;
}

.ascent-sci__temp-label--yellow { color: #fbec00; }

.ascent-sci__temp-bar {
  width: 56px;
}

.ascent-sci__temp-bar--tall { height: 90px; }
.ascent-sci__temp-bar--short { height: 22px; }
.ascent-sci__temp-bar--white { background: #ffffff; }
.ascent-sci__temp-bar--yellow-fill { background: #fbec00; }

.ascent-sci__temp-name {
  font-family: 'IBM Plex Mono', monospace;
  font-weight: 600;
  font-size: 9px;
  line-height: 13px;
  letter-spacing: 0.54px;
  color: #ffffff;
  margin: 0;
}

.ascent-sci__dots {
  display: flex;
  flex-direction: row;
  gap: 6px;
  margin-block-start: 8px;
  flex-wrap: wrap;
}

.ascent-sci__dot {
  width: 15px;
  height: 15px;
  border-radius: 50%;
  background: #fbec00;
  flex-shrink: 0;
}

.ascent-sci__intact-label {
  font-family: 'IBM Plex Mono', monospace;
  font-weight: 600;
  font-size: 10px;
  line-height: 14px;
  letter-spacing: 0.6px;
  color: #ffffff;
  margin: 4px 0 0;
}

@media screen and (min-width: 750px) {
  .ascent-sci {
    padding-inline: 56px;
  }

  .ascent-sci__header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }

  .ascent-sci__heading {
    font-size: 42px;
    line-height: 51px;
  }

  .ascent-sci__subtext {
    font-size: 20px;
    line-height: 24px;
  }

  .ascent-sci__cards {
    flex-direction: row;
    gap: 30px;
  }

  .ascent-sci__card {
    flex: 1;
    min-width: 0;
  }

  .ascent-sci__stat {
    font-size: 88px;
    line-height: 92px;
    letter-spacing: -2.64px;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Science",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "section_label",
      "label": "Section label",
      "default": "THE SCIENCE"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "There's nothing more fundamental to performance than what you feed it."
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Every ingredient is backed by research and rigorously tested to fuel your body at its best"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA text",
      "default": "READ THE STUDIES"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA link"
    },
    {
      "type": "header",
      "content": "Card 1 — The Trigger"
    },
    {
      "type": "text",
      "id": "card1_title",
      "label": "Card 1 title",
      "default": "The Trigger."
    },
    {
      "type": "text",
      "id": "card1_subtitle",
      "label": "Card 1 subtitle",
      "default": "Muscle protein synthesis starts at 2.3g leucine."
    },
    {
      "type": "text",
      "id": "card1_stat",
      "label": "Card 1 stat",
      "default": "2.6g"
    },
    {
      "type": "text",
      "id": "card1_stat_label",
      "label": "Card 1 stat label",
      "default": "per scoop. past the trigger."
    },
    {
      "type": "header",
      "content": "Card 2 — The Spike"
    },
    {
      "type": "text",
      "id": "card2_title",
      "label": "Card 2 title",
      "default": "The Spike."
    },
    {
      "type": "text",
      "id": "card2_subtitle",
      "label": "Card 2 subtitle",
      "default": "Native whey hits blood faster, and higher."
    },
    {
      "type": "text",
      "id": "card2_stat",
      "label": "Card 2 stat",
      "default": "+20%"
    },
    {
      "type": "text",
      "id": "card2_stat_label",
      "label": "Card 2 stat label",
      "default": "higher peak leucine."
    },
    {
      "type": "header",
      "content": "Card 3 — The Cold Truth"
    },
    {
      "type": "text",
      "id": "card3_title",
      "label": "Card 3 title",
      "default": "The Cold Truth."
    },
    {
      "type": "text",
      "id": "card3_subtitle",
      "label": "Card 3 subtitle",
      "default": "Heat wrecks protein. We never apply it."
    },
    {
      "type": "text",
      "id": "card3_stat",
      "label": "Card 3 stat",
      "default": "0"
    },
    {
      "type": "text",
      "id": "card3_stat_label",
      "label": "Card 3 stat label",
      "default": "proteins denatured."
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 80,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 80,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Science"
    }
  ]
}
{% endschema %}

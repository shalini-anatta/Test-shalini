<div
  class="ascent-nl"
  style="--nl-pad-top: {{ section.settings['padding-block-start'] }}px; --nl-pad-bottom: {{ section.settings['padding-block-end'] }}px;"
>
  <div class="ascent-nl__inner ascent-nl__inner--{{ section.settings.alignment }}">
    {%- if section.settings.heading != blank -%}
      <h2 class="ascent-nl__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.subtext != blank -%}
      <p class="ascent-nl__subtext">{{ section.settings.subtext }}</p>
    {%- endif -%}
    {%- form 'customer' -%}
      {%- if form.errors -%}
        <div class="ascent-nl__error" role="alert">
          {%- for field in form.errors -%}
            <p>{{ form.errors.messages[field] }}</p>
          {%- endfor -%}
        </div>
      {%- elsif form.posted_successfully? -%}
        <p class="ascent-nl__success">Thanks for subscribing!</p>
      {%- endif -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="ascent-nl__form-row">
        <label for="NewsletterEmail-{{ section.id }}" class="visually-hidden">Email address</label>
        <input
          id="NewsletterEmail-{{ section.id }}"
          class="ascent-nl__input"
          type="email"
          name="contact[email]"
          placeholder="{{ section.settings.placeholder_text }}"
          autocomplete="email"
          required
        >
        <button type="submit" class="ascent-nl__btn">
          {{ section.settings.button_text }}
        </button>
      </div>
    {%- endform -%}
  </div>
</div>

{% stylesheet %}
.ascent-nl {
  background: #f8f8f8;
  padding-block-start: var(--nl-pad-top, 80px);
  padding-block-end: var(--nl-pad-bottom, 80px);
  padding-inline: 20px;
}

.ascent-nl__inner {
  max-width: 700px;
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.ascent-nl__inner--left {
  margin-inline-start: 0;
  margin-inline-end: auto;
}

.ascent-nl__inner--center {
  text-align: center;
  margin-inline: auto;
}

.ascent-nl__heading {
  font-family: 'Neue Haas Grotesk Display Pro', system-ui, sans-serif;
  font-weight: 600;
  font-size: 32px;
  line-height: 36px;
  color: #1a1a1a;
  margin: 0;
}

.ascent-nl__subtext {
  font-family: 'Proxima Nova', Arial, sans-serif;
  font-weight: 400;
  font-size: 16px;
  line-height: 24px;
  color: #414141;
  margin: 0;
}

.ascent-nl__error {
  color: #c00000;
  font-family: 'Proxima Nova', Arial, sans-serif;
  font-size: 14px;
  line-height: 20px;
}

.ascent-nl__success {
  font-family: 'Proxima Nova', Arial, sans-serif;
  font-size: 16px;
  line-height: 24px;
  color: #1a1a1a;
  margin: 0;
}

.ascent-nl__form-row {
  display: flex;
  flex-direction: column;
  gap: 12px;
  width: 100%;
}

.ascent-nl__input {
  width: 100%;
  height: 52px;
  padding: 0 16px;
  border: 1.5px solid #1a1a1a;
  background: #ffffff;
  font-family: 'Proxima Nova', Arial, sans-serif;
  font-size: 16px;
  color: #1a1a1a;
  outline: none;
  box-sizing: border-box;
}

.ascent-nl__input::placeholder {
  color: #919191;
}

.ascent-nl__input:focus {
  border-color: #fbec00;
}

.ascent-nl__btn {
  height: 52px;
  padding: 0 32px;
  background: #1a1a1a;
  color: #fbec00;
  font-family: 'IBM Plex Mono', monospace;
  font-weight: 600;
  font-size: 16px;
  line-height: 20px;
  letter-spacing: 0.96px;
  border: none;
  cursor: pointer;
  white-space: nowrap;
  flex-shrink: 0;
}

.ascent-nl__btn:hover {
  background: #2a2a2a;
}

@media screen and (min-width: 576px) {
  .ascent-nl__form-row {
    flex-direction: row;
  }

  .ascent-nl__input {
    flex: 1;
    width: auto;
  }
}

@media screen and (min-width: 750px) {
  .ascent-nl {
    padding-inline: 56px;
  }

  .ascent-nl__heading {
    font-size: 42px;
    line-height: 48px;
  }

  .ascent-nl__subtext {
    font-size: 18px;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Newsletter",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Stay in the loop."
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "New products, early drops, training tips — right to your inbox."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "SUBSCRIBE"
    },
    {
      "type": "text",
      "id": "placeholder_text",
      "label": "Email placeholder",
      "default": "Enter your email"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ]
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 80,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 80,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}

<div
  class="ascent-guarantee"
  style="--guar-pad-top: {{ section.settings['padding-block-start'] }}px; --guar-pad-bottom: {{ section.settings['padding-block-end'] }}px;"
>
  <div class="ascent-guarantee__inner">
    <div class="ascent-guarantee__text">
      {%- if section.settings.heading != blank -%}
        <h2 class="ascent-guarantee__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="ascent-guarantee__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>
    {%- if section.settings.cta_text != blank -%}
      <a
        class="ascent-guarantee__cta"
        href="{{ section.settings.cta_url | default: '#' }}"
      >{{ section.settings.cta_text }}</a>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
.ascent-guarantee {
  background: #fbec00;
  padding-block-start: var(--guar-pad-top, 60px);
  padding-block-end: var(--guar-pad-bottom, 60px);
  padding-inline: 20px;
}

.ascent-guarantee__inner {
  max-width: 1328px;
  margin-inline: auto;
  display: flex;
  flex-direction: column;
  gap: 32px;
}

.ascent-guarantee__text {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.ascent-guarantee__heading {
  font-family: 'Neue Haas Grotesk Display Pro', system-ui, sans-serif;
  font-weight: 600;
  font-size: 28px;
  line-height: 32px;
  color: #1a1a1a;
  margin: 0;
}

.ascent-guarantee__subheading {
  font-family: 'Neue Haas Grotesk Display Pro', system-ui, sans-serif;
  font-weight: 400;
  font-size: 18px;
  line-height: 24px;
  color: #1a1a1a;
  margin: 0;
}

.ascent-guarantee__cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 14px 30px;
  background: #1a1a1a;
  color: #fbec00;
  font-family: 'IBM Plex Mono', monospace;
  font-weight: 600;
  font-size: 16px;
  line-height: 20px;
  letter-spacing: 0.96px;
  text-decoration: none;
  white-space: nowrap;
  flex-shrink: 0;
}

.ascent-guarantee__cta:hover {
  background: #2a2a2a;
}

@media screen and (min-width: 750px) {
  .ascent-guarantee {
    padding-inline: 56px;
  }

  .ascent-guarantee__inner {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }

  .ascent-guarantee__heading {
    font-size: 37px;
    line-height: 42px;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Guarantee",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Feel the difference in 30 days, or it's on us."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Empty bag and all."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA text",
      "default": "START RISK-FREE"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA link"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 60,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Guarantee"
    }
  ]
}
{% endschema %}

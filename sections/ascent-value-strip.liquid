<div class="ascent-strip" style="--strip-speed: {{ section.settings.speed }}s;">
  <div class="ascent-strip__track">
    <div class="ascent-strip__inner">
      {%- for block in section.blocks -%}
        <div class="ascent-strip__cell" {{ block.shopify_attributes }}>
          <span class="ascent-strip__icon">
            {%- case block.settings.icon -%}
              {%- when 'plant' -%}
                {{ 'plant-2.svg' | inline_asset_content }}
              {%- when 'person' -%}
                {{ 'person.svg' | inline_asset_content }}
              {%- when 'sealcheck' -%}
                {{ 'sealcheck.svg' | inline_asset_content }}
              {%- when 'heart' -%}
                {{ 'heart.svg' | inline_asset_content }}
            {%- endcase -%}
          </span>
          {%- if block.settings.text != blank -%}
            <span class="ascent-strip__text">{{ block.settings.text }}</span>
          {%- endif -%}
        </div>
      {%- endfor -%}
      {%- comment -%}Duplicate set for seamless marquee loop{%- endcomment -%}
      {%- for block in section.blocks -%}
        <div class="ascent-strip__cell" aria-hidden="true">
          <span class="ascent-strip__icon">
            {%- case block.settings.icon -%}
              {%- when 'plant' -%}
                {{ 'plant-2.svg' | inline_asset_content }}
              {%- when 'person' -%}
                {{ 'person.svg' | inline_asset_content }}
              {%- when 'sealcheck' -%}
                {{ 'sealcheck.svg' | inline_asset_content }}
              {%- when 'heart' -%}
                {{ 'heart.svg' | inline_asset_content }}
            {%- endcase -%}
          </span>
          {%- if block.settings.text != blank -%}
            <span class="ascent-strip__text">{{ block.settings.text }}</span>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
@keyframes ascent-strip-scroll {
  from { transform: translateX(0); }
  to { transform: translateX(-50%); }
}

.ascent-strip {
  background: #1a1a1a;
  height: 60px;
  overflow: hidden;
  display: flex;
  align-items: center;
}

.ascent-strip__track {
  overflow: hidden;
  width: 100%;
}

.ascent-strip__inner {
  display: flex;
  flex-direction: row;
  align-items: center;
  width: max-content;
  animation: ascent-strip-scroll var(--strip-speed, 30s) linear infinite;
}

.ascent-strip__cell {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8px;
  padding-inline: 20px;
  height: 60px;
  flex-shrink: 0;
}

.ascent-strip__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 24px;
  height: 24px;
  flex-shrink: 0;
}

.ascent-strip__icon svg {
  width: 24px;
  height: 24px;
}

.ascent-strip__text {
  font-family: 'Geist Mono', monospace;
  font-weight: 700;
  font-size: 14px;
  line-height: 18px;
  text-transform: uppercase;
  color: #ffffff;
  white-space: nowrap;
}

@media (prefers-reduced-motion: reduce) {
  .ascent-strip__inner {
    animation-play-state: paused;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Value strip",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "label": "Scroll speed (seconds)",
      "min": 10,
      "max": 60,
      "step": 5,
      "default": 30,
      "unit": "s"
    }
  ],
  "blocks": [
    {
      "type": "value-prop",
      "name": "Value prop",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "plant",
          "options": [
            { "value": "plant", "label": "Zero Artificial Flavors" },
            { "value": "person", "label": "Clean Build" },
            { "value": "sealcheck", "label": "3rd Party Tested" },
            { "value": "heart", "label": "Higher Levels of Leucine" }
          ]
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Value prop text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Value strip",
      "blocks": [
        { "type": "value-prop", "settings": { "icon": "plant", "text": "Zero Artificial Flavors" } },
        { "type": "value-prop", "settings": { "icon": "person", "text": "Clean Build" } },
        { "type": "value-prop", "settings": { "icon": "sealcheck", "text": "3rd Party Tested" } },
        { "type": "value-prop", "settings": { "icon": "heart", "text": "Higher Levels of Leucine" } }
      ]
    }
  ]
}
{% endschema %}
